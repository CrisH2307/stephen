{
  "name": "stephen",
  "version": "0.1.0",
  "description": "Stephen lets Claude use your Mac's browsers (Zen via WebDriver BiDi, Chrome via CDP) by voice or from Claude Code, behind a safety gate. MCP server.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "stephen": "dist/cli.js",
    "browser-hub": "dist/cli.js"
  },
  "files": [
    "dist",
    "helper",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/**/*.int.test.ts'",
    "test:int": "vitest run test/**/*.int.test.ts",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@picovoice/pvrecorder-node": "1.2.9",
    "puppeteer-core": "25.16.0",
    "sherpa-onnx-node": "1.13.8",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "^22",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
